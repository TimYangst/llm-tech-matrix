# Copy to `.env` and fill in real values. `.env` is gitignored; this template is committed.
# Load via python-dotenv (`uv add python-dotenv`) or `huggingface_hub`'s built-in env support.

# HuggingFace — used to download gated configs / models.
# Generate at https://huggingface.co/settings/tokens (read-only is enough for config.json pulls).
HF_TOKEN=

# (Optional) OpenAI / Anthropic / etc. keys for the extraction-layer LLM, if you use them.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
