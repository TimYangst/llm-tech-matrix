      ]
    },
    "expert": {
      "supported": true,
      "implementation": "ep_size (--expert-parallel-size / --ep); moe_a2a_backend selects the all-to-all backend (deepep, mooncake, nixl, mori, ...)",
      "notes": "The EP guide states DeepEP, Mooncake, NIXL-EP, ascend_fuseep, pplx and MORI only support ep_size = tp_size. v0.5.19 adds a DeepEP v2 ElasticBuffer backend (--moe-a2a-backend deepep_v2) for DeepSeek-V3/V4 and Qwen3-MoE in FP8.",
      "evidence": [
        "https://github.com/sgl-project/sglang/blob/0bcd822377da7b5718e674eaf9c870d349424dd1/python/sglang/srt/server_args.py#L2360",
