        "https://github.com/sgl-project/sglang/releases/tag/v0.5.19"
      ]
    },
    "context": {
      "supported": true,
      "implementation": "dcp_size (--decode-context-parallel-size): stripes the MLA KV cache by token position across a TP group; attn_cp_size (--attention-context-parallel-size)",
