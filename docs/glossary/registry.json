{
  "registry_version": 1,
  "_doc": "Controlled vocabulary linking typed extraction fields to glossary entries. Machine-readable companion to docs/glossary/README.md. 'aliases' are the literal values that have appeared in data/extracted/*.json for that technique; matching is case-insensitive. Values listed under 'taxonomy' are structural classifiers, NOT techniques — they are deliberately unmapped so the validator does not flag them. Any value in a registered slot that is neither an alias nor taxonomy fails scripts/validate_registry.py, which is how vocabulary drift gets caught at PR time.",
  "slots": [
    "architecture.attention.variant",
    "architecture.attention.variants[].name",
    "architecture.attention.sparse_attention.kind",
    "architecture.attention.rope.type",
    "architecture.backbone.context_extension.method",
    "architecture.residual_connections.kind",
    "training.quantization.weight_format",
    "multimodal.fusion",
    "training.alignment.tool_call_protocol.format",
    "architecture.auxiliary_modules[].purpose"
  ],
  "taxonomy": {
    "_doc": "Structural classifiers with no glossary entry — a shape, not a named technique.",
