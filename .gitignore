# --- Secrets / local config (never commit) ---
.env
.env.*
!.env.example
.secrets
.secrets.*
*.key
*.pem
credentials.json

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
*.egg
build/
dist/
develop-eggs/
.eggs/
pip-wheel-metadata/

# --- uv / venv ---
.venv/
venv/
env/
# .python-version is COMMITTED (it pins Python 3.13). Inline comments are not
# supported in .gitignore — the whole line becomes the pattern — so uncomment the
# line below only if you actually want it ignored.
# .python-version

# --- Tooling caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/

# --- Claude Code worktrees (created by `claude --worktree`) ---
.claude/worktrees/

# --- Local-only Claude Code scratch (e.g. PR drafts produced by the draft-pr skill) ---
.claude/drafts/

# --- IDE / OS ---
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Notebooks ---
.ipynb_checkpoints/

# --- Project-specific scratch ---
scratch/
tmp/
# local-only working notes: PR titles/bodies, draft text, throwaway output
.tmp/
*.local.*

# --- Model source cache ---
# Cached source assets (HF configs, papers, blogs) are NOT committed —
# only the manifest.json per model is, so a fresh clone can re-fetch them.
data/sources/**
!data/sources/
!data/sources/**/
!data/sources/**/manifest.json
