# --- Secrets / local config (never commit) ---
.env
.env.*
!.env.example
.secrets
.secrets.*
*.key
*.pem
credentials.json

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
*.egg
build/
dist/
develop-eggs/
.eggs/
pip-wheel-metadata/

# --- uv / venv ---
.venv/
venv/
env/
.python-version  # keep this commented if you want to pin Python version in git; uncomment to ignore

# --- Tooling caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/

# --- Claude Code worktrees (created by `claude --worktree`) ---
.claude/worktrees/

# --- IDE / OS ---
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Notebooks ---
.ipynb_checkpoints/

# --- Project-specific scratch ---
scratch/
tmp/
*.local.*

# --- Model source cache ---
# Cached source assets (HF configs, papers, blogs) are NOT committed —
# only the manifest.json per model is, so a fresh clone can re-fetch them.
data/sources/**
!data/sources/
!data/sources/**/
!data/sources/**/manifest.json
